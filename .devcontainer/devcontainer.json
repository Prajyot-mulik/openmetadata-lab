cat > .devcontainer/devcontainer.json <<'EOF'
{
  "name": "OpenMetadata Lab",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": { "cpus": 4, "memory": "16gb" },
  "forwardPorts": [8585],
  "portsAttributes": { "8585": { "label": "OpenMetadata UI" } },
  "postStartCommand": "bash .devcontainer/start-om.sh"
}
EOF
git add .devcontainer/devcontainer.json
git commit -m "use universal image (docker built in)"
git push
